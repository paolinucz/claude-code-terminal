{
  "name": "claude-code-terminal",
  "productName": "Claude Code Terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app per Windows che riunisce terminali Claude Code, shell, file, revisione e widget",
  "author": "Paolo Coletta",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "it.coletta.claude-code-terminal",
    "productName": "Claude Code Terminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Claude-Code-Terminal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Code Terminal",
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dockview": "^8.8.3",
    "dockview-react": "^8.8.3",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.10.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "vscode-jsonrpc": "^10.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
